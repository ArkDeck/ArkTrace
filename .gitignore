# macOS
.DS_Store

# Swift Package Manager
/.build
.swiftpm/

# Xcode
DerivedData/
xcuserdata/
*.xcresult
# `xcodebuild -project apple/ArkTrace.xcodeproj` writes ArkTrace.app here
/build

# Profiling / scratch
*.profraw

# Pinned TraceStreamer binary is built locally via hack/build_trace_streamer.sh;
# only the provenance manifest is committed.
third_party/trace-streamer/macx/trace_streamer
# Windows: hack/build_trace_streamer_windows.sh; manifest.json is committed.
third_party/trace-streamer/windows-x86_64/trace_streamer.exe
third_party/trace-streamer/windows-x86_64/.*.partial

# API baseline consumer build products
hack/api-baseline/.build/

# Python bytecode from the hack/ verifiers
__pycache__/
*.pyc

# Cargo artifacts are managed outside the worktree by run-cargo.py.
/rust/target/
