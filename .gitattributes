# Oracle receipts bind source and JSON bytes on both native checkout platforms.
*.swift text eol=lf
*.rs text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.md text eol=lf

# Frozen unified diffs and producer logs bind exact upstream bytes.
*.patch -text
*.log -text

ThirdParty/TraceStreamer/LICENSES/hiperf-Apache-2.0.txt text eol=crlf
ThirdParty/TraceStreamer/LICENSES/sqlite-Public-Domain.txt text eol=crlf

# License hashes bind the exact upstream bytes, including line endings.
rust/licenses/** -text
