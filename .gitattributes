# Oracle receipts bind source and JSON bytes on both native checkout platforms.
*.swift text eol=lf
*.rs text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.md text eol=lf

# Frozen unified diffs and producer logs bind exact upstream bytes.
*.patch -text
*.log -text

# Original Swift construction SQL/logs retain their receipt-bound whitespace.
/docs/migration-runs/archived-tool-evidence/parallel-summary-facts-canonical-20261004/fixtures/*.sql -text whitespace=-blank-at-eol,-blank-at-eof
/rust/crates/arktrace-store/tests/fixtures/summary-*.sql -text whitespace=-blank-at-eol,-blank-at-eof
/docs/migration-runs/archived-tool-evidence/parallel-summary-facts-canonical-20261004/verification/construction-seam-oracle-build.log whitespace=-blank-at-eol

# Windows resource inputs participate in the recipe hash as exact bytes.
third_party/TraceStreamer/windows/** -text

third_party/TraceStreamer/LICENSES/hiperf-Apache-2.0.txt text eol=crlf
third_party/TraceStreamer/LICENSES/sqlite-Public-Domain.txt text eol=crlf
# Windows license texts keep the exact bytes (CRLF for the mingw-builds archive copies).
third_party/TraceStreamer/LICENSES-windows/** -text

# License hashes bind the exact upstream bytes, including line endings.
rust/licenses/** -text

# Linguist: generated evidence and vendored upstream bytes stay out of language stats.
# These attributes do not change checkout bytes. -text and eol rules above still apply.
docs/migration-runs/** linguist-generated
tools/**/fixtures/** linguist-vendored
**/*-oracle.json linguist-generated
api/*.json linguist-generated
rust/licenses/** linguist-vendored
third_party/** linguist-vendored

# Files larger than 500 KiB. CI checkouts set lfs: true so receipt hashes see the bytes.
