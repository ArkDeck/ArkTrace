# Oracle receipts bind source and JSON bytes on both native checkout platforms.
*.swift text eol=lf
*.rs text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.md text eol=lf

# Frozen unified diffs and producer logs bind exact upstream bytes.
*.patch -text
*.log -text

# Original Swift construction SQL/logs retain their receipt-bound whitespace.
/tools/parallel-summary-facts-canonical-20261004/fixtures/*.sql -text whitespace=-blank-at-eol,-blank-at-eof
/rust/crates/arktrace-store/tests/fixtures/summary-*.sql -text whitespace=-blank-at-eol,-blank-at-eof
/tools/parallel-summary-facts-canonical-20261004/verification/construction-seam-oracle-build.log whitespace=-blank-at-eol

ThirdParty/TraceStreamer/LICENSES/hiperf-Apache-2.0.txt text eol=crlf
ThirdParty/TraceStreamer/LICENSES/sqlite-Public-Domain.txt text eol=crlf

# License hashes bind the exact upstream bytes, including line endings.
rust/licenses/** -text
