{
  "sourceLanguage": "en",
  "strings": {
    "ArkTrace and third-party license notices": {
      "comment": "Accessibility string resolved from a typed key supplied by ArkTraceAppSupport.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ArkTrace- und Drittanbieter-Lizenzhinweise"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ArkTrace and third-party license notices"
          }
        }
      }
    },
    "Dismiss": {
      "comment": "Closes an error banner while keeping the current document open.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dismiss"
          }
        }
      }
    },
    "Dock Inspector": {
      "comment": "Menu that chooses which edge the Inspector is docked to.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Informationsbereich andocken"
          }
        }
      }
    },
    "Dock to Bottom": {
      "comment": "Menu item that docks the Inspector under the timeline.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unten andocken"
          }
        }
      }
    },
    "Dock to Right": {
      "comment": "Menu item that docks the Inspector beside the timeline.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechts andocken"
          }
        }
      }
    },
    "Hide Inspector": {
      "comment": "Button that collapses the Inspector pane.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Informationsbereich ausblenden"
          }
        }
      }
    },
    "Show Inspector": {
      "comment": "Button that restores the Inspector pane.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Informationsbereich wieder einblenden"
          }
        }
      }
    },
