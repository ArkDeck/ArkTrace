          "stringUnit": {
            "state": "translated",
            "value": "Kein gespeicherter Zustand zum Sichern vorhanden. Fügen Sie zuerst ein Flag, eine dauerhafte Markierung oder einen Favoriten hinzu."
          }
        }
      }
    },
