    "No saved state to back up. Add a flag, persistent mark, or favorite first.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No saved state to back up. Add a flag, persistent mark, or favorite first."
