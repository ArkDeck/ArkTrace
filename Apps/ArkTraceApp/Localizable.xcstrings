    "A backup contains saved flags, persistent marks, and favorites. To use new saved state after returning to an older app, restore the backup separately. The older app does not read it automatically.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A backup contains saved flags, persistent marks, and favorites. To use new saved state after returning to an older app, restore the backup separately. The older app does not read it automatically."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Sicherung enthält gespeicherte Flags, dauerhafte Markierungen und Favoriten. Stellen Sie die Sicherung separat wieder her, um neue Zustände nach der Rückkehr zu einer älteren App zu nutzen. Die ältere App liest die Sicherung nicht automatisch."
          }
        }
      }
    },
    "Backing Up Saved State…": {
      "extractionState": "manual",
