    "Several older states contain different annotations. Choose one to import. The trace stays open, and all original files and backups are kept.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mehrere ältere Zustände enthalten unterschiedliche Anmerkungen. Wählen Sie einen zum Importieren aus. Der Trace bleibt geöffnet und alle Originaldateien und Sicherungen werden beibehalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Several older states contain different annotations. Choose one to import. The trace stays open, and all original files and backups are kept."
