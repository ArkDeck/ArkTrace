    "Create a separate copy of saved flags, persistent marks, and favorites. Backups stay available after the trace cache is cleared.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a separate copy of saved flags, persistent marks, and favorites. Backups stay available after the trace cache is cleared."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle eine separate Kopie gespeicherter Markierungen, dauerhafter Bereiche und Favoriten. Backups bleiben nach dem Leeren des Trace-Caches verfügbar."
          }
        }
      }
    },
    "The saved state could not be read. Its original file was kept. No backup was created.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved state could not be read. Its original file was kept. No backup was created."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der gespeicherte Zustand konnte nicht gelesen werden. Die Originaldatei wurde beibehalten. Es wurde kein Backup erstellt."
          }
        }
      }
    },
