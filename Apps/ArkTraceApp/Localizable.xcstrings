{
  "sourceLanguage": "en",
  "strings": {
    "Hide Inspector": {
      "comment": "Button that collapses the Inspector pane.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Informationsbereich ausblenden"
          }
        }
      }
    },
    "Show Inspector": {
      "comment": "Button that restores the Inspector pane.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Informationsbereich wieder einblenden"
          }
        }
      }
    },
